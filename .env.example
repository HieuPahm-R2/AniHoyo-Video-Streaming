# =============================================================================
#  AniHoyo stack configuration - TEMPLATE
#  Copy to `.env` and fill in the real secrets:
#      cp .env.example .env
# =============================================================================

# ---------------------------------------------------------------- Web tier --
# Host port that nginx (the only published service) listens on. nginx itself
# always listens on 80 *inside* the container; this only maps it to the host.
# 80 = standard HTTP. Use 8080 (or anything else) if 80 is taken.
WEB_PORT=80

# Leave EMPTY so the SPA talks to its own origin and nginx proxies /api and
# /storage (recommended). Only set an absolute URL if you serve the frontend
# from somewhere else.
VITE_BACKEND_URL=
VITE_ACL_ENABLE=true

# ----------------------------------------------------------------- MySQL ----
MYSQL_DATABASE=anihoyo
MYSQL_USER=anihoyo
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_too

# ------------------------------------------------------------------- Auth ---
# Base64 HS256 signing key (anihoyo.jwt.base64-secret). Generate a fresh one:
#   openssl rand -base64 64
JWT_SECRET=change_me
VIEW_COOKIE_SECURE=false

# --------------------------------------------------------- Cloudflare R2 ----
# Dashboard > R2 > API > Manage API Tokens. The token needs Object Read & Write
# on BOTH buckets. Account ID is the hex prefix of the S3 endpoint host.
R2_ENABLED=true
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_SOURCE_BUCKET=anihoyo-source
R2_MEDIA_BUCKET=anihoyo-media
# Custom domain / r2.dev URL that publicly serves R2_MEDIA_BUCKET.
R2_PUBLIC_BASE_URL=https://media.example.com
R2_HLS_PREFIX=hls
# true (mặc định) = backend tự stream HLS playlists/segments -> cùng origin với
#   SPA, không cần CORS trên bucket, hls.js chạy ở mọi trình duyệt.
# false = trả 302 sang R2_PUBLIC_BASE_URL để CDN phục vụ video (nhẹ VPS hơn),
#   nhưng khi đó bucket PHẢI có CORS policy cho origin của SPA, nếu không
#   hls.js sẽ bị chặn khi tải playlist/segment.
R2_HLS_RELAY=true

# ------------------------------------------------------------- SeaweedFS ----
# Object storage for the images that used to be written to the backend's own
# disk: posters (visual/slider), thumbnails and avatars. Videos stay on R2.
# The same key pair must be given to the `seaweedfs` service and the backend;
# it is what switches the S3 gateway out of "allow all anonymous" mode.
SEAWEEDFS_ENABLED=true
SEAWEEDFS_ENDPOINT=http://seaweedfs:8333
SEAWEEDFS_ACCESS_KEY_ID=anihoyo
SEAWEEDFS_SECRET_ACCESS_KEY=change_me
SEAWEEDFS_BUCKET=anihoyo-media
SEAWEEDFS_REGION=us-east-1
# Keep reading not-yet-migrated images from ./data/uploads instead of 404ing.
# Set to false once `deploy/seaweedfs/migrate-uploads.ps1` has been run.
SEAWEEDFS_FALLBACK_TO_LOCAL=true
# Loopback ports published for `aws s3` debugging and the migration script.
SEAWEEDFS_S3_PORT=8333
SEAWEEDFS_MASTER_PORT=9333

# ------------------------------------------------------------------ Misc ----
TZ=Asia/Ho_Chi_Minh
JAVA_MAX_RAM_PERCENT=60
