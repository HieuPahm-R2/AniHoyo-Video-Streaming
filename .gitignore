# Local configuration and secrets (templates are safe to commit).
.env
.env.*
!.env.example
!.env.*.example

# Dependencies and build output.
**/node_modules/
**/dist/
**/dist-ssr/
**/target/

# Runtime uploads stay local; retain the directory in fresh clones.
/data/*
!/data/uploads/
/data/uploads/*
!/data/uploads/.gitkeep

# Local editor state and logs. Shared .vscode configuration is tracked.
**/.idea/
*.log
.DS_Store
Thumbs.db
